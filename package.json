{
  "name": "hyper-chess-board",
  "version": "0.2.4",
  "description": "Provides legal move generation and front-end display for the chess variant Hyper Chess",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./pgn": "./dist/pgn/index.js",
    "./graphics": "./dist/graphics/index.js",
    "./browser": "./dist/browser.js"
  },
  "scripts": {
    "clean": "node scripts/clean.js",
    "build": "npm run clean && tsc",
    "test": "vitest",
    "bench:build": "node scripts/clean-bench.js && npx tsc -p tsconfig.bench.json",
    "bench:perft": "npm run bench:build && npm run bench:perft:run",
    "bench:perft:run": "node dist-bench/bench/perft.js",
    "bench:perft:profile": "npm run bench:build && node --cpu-prof dist-bench/bench/perft.js",
    "bench:pgn-parse": "npm run bench:build && npm run bench:pgn-parse:run",
    "bench:pgn-parse:run": "node dist-bench/bench/pgn-parse.js",
    "bench:pgn-parse:profile": "npm run bench:build && node --cpu-prof dist-bench/bench/pgn-parse.js",
    "bench": "npm run bench:build && npm run bench:perft:run && npm run bench:pgn-parse:run"
  },
  "author": "Norbert Krajewski",
  "license": "ISC",
  "type": "module",
  "files": [
    "/dist",
    "/graphics/styles",
    "/graphics/images"
  ],
  "devDependencies": {
    "@types/node": "^25.7.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  }
}
